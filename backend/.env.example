# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
CORS_ORIGIN=http://localhost:5300

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://127.0.0.1:27017/resume_builder

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Secret used to encrypt OAuth refresh tokens, portal cookies and API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Background work ──────────────────────────────────────────────────────────
# inline  — jobs run in this process right after they are queued (no Redis needed).
# bullmq  — jobs go to Redis and survive restarts; requires REDIS_URL.
QUEUE_DRIVER=inline
REDIS_URL=
# Set false on API-only processes when a separate worker process owns the queues.
RUN_WORKERS=true
# Crons must run in exactly one process.
RUN_SCHEDULED_JOBS=true

# ── Files ────────────────────────────────────────────────────────────────────
# Uploaded resumes and generated PDFs. Keep outside any web root.
STORAGE_DIR=./storage
RESUME_MAX_BYTES=5242880
# poppler-utils pdftotext is used when installed (recommended); otherwise pdf.js.
PDFTOTEXT_PATH=pdftotext
# Concurrent PDF renders per process (CPU-bound).
RESUME_RENDER_CONCURRENCY=2

# ── Job sources ──────────────────────────────────────────────────────────────
# JSearch on RapidAPI — aggregates Google for Jobs (LinkedIn, Indeed, Naukri, Glassdoor, career pages)
JSEARCH_API_KEY=
JSEARCH_DATE_POSTED=week
# Adzuna — https://developer.adzuna.com (official, free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Apify actors (unofficial scrapers; disabled per user until they opt in).
# Actor ids and input JSON vary by actor; {{title}}, {{location}}, {{limit}} are substituted.
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=
APIFY_LINKEDIN_INPUT={"title":"{{title}}","location":"{{location}}","rows":"{{limit}}"}
APIFY_NAUKRI_ACTOR=
APIFY_NAUKRI_INPUT={"keyword":"{{title}}","location":"{{location}}","maxJobs":"{{limit}}"}
JOBS_PER_QUERY=20
JOB_DISCOVERY_CRON=0 * * * *
JOB_DISCOVERY_INTERVAL_HOURS=6
DISCOVERY_MIN_INTERVAL_MINUTES=10
# Jobs whose keyword score is below this never reach the model.
MATCH_PREFILTER_MIN=25
MATCH_BATCH_SIZE=5

# ── Hiring posts ─────────────────────────────────────────────────────────────
# SerpAPI (Google results for site:linkedin.com/posts). Free tier is ~100 searches/month.
SERPAPI_KEY=
# Google time filter: qdr:d (day), qdr:w (week), qdr:m (month)
SERPAPI_TIME_RANGE=qdr:w
# Optional unofficial LinkedIn posts actor; {{title}} receives the full boolean query.
APIFY_LINKEDIN_POSTS_ACTOR=
APIFY_LINKEDIN_POSTS_INPUT={"searchQueries":["{{title}}"],"maxPosts":"{{limit}}"}
HIRING_POSTS_PER_QUERY=20
HIRING_POST_MIN_INTERVAL_MINUTES=60

# ── Mail and outreach ────────────────────────────────────────────────────────
# Gmail sending uses OAuth 2.0 with only the gmail.send scope (Gmail has no API-key send).
# Create an OAuth client (Web application) in Google Cloud Console and add this redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3100/api/mail-connector/gmail/callback
# Where the OAuth callback sends the browser afterwards.
FRONTEND_URL=http://localhost:5300
# Users without Google OAuth can connect any SMTP server, e.g. smtp.gmail.com:465 with an App Password.
OUTREACH_FOLLOWUP_DAYS=5
OUTREACH_FOLLOWUP_CRON=0 9 * * *
REVIEW_REMINDER_DAYS=2
REVIEW_REMINDER_CRON=0 8 * * *

# ── Assisted apply ───────────────────────────────────────────────────────────
# System Chrome/Chromium driven by puppeteer-core. Auto-detected when unset.
CHROME_PATH=
# Extra flags, comma separated (e.g. --no-sandbox inside some containers).
CHROME_ARGS=
APPLY_CONCURRENCY=1
APPLY_TIMEOUT_MS=180000
# Additional hosts treated as simple application forms (beyond the built-in ATS list).
APPLY_FORM_HOSTS=

# ── AI providers (free tiers first) ──────────────────────────────────────────
# Order the router tries providers in. Unconfigured ones are skipped.
LLM_PROVIDER_CHAIN=groq,gemini,opencode,anthropic
# Per-task override, e.g. send tailoring to a paid model first:
# LLM_ROUTE_RESUME_TAILOR=anthropic,groq
LLM_TIMEOUT_MS=60000
# Budget counters live in Redis when REDIS_URL is set (shared across processes), else in memory.
# LLM_BUDGET_STORE=memory

# Groq — https://console.groq.com/keys (free: ~30 RPM, per-model daily token caps, org-wide)
GROQ_API_KEY=
# Groq's line-up changes; check https://console.groq.com/docs/models if these stop working.
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_LARGE_MODEL=openai/gpt-oss-120b
GROQ_RPM=28
GROQ_TOKENS_PER_DAY=95000

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_SMALL_MODEL=gemini-2.5-flash-lite
GEMINI_LARGE_MODEL=gemini-2.5-flash
GEMINI_RPM=9
GEMINI_TOKENS_PER_DAY=200000

# OpenCode Zen — https://opencode.ai/zen (OpenAI-compatible; free models rotate, so no defaults)
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_SMALL_MODEL=
OPENCODE_ZEN_LARGE_MODEL=
OPENCODE_ZEN_JSON_MODE=false

# Anthropic (paid, optional) — off until a key is set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
